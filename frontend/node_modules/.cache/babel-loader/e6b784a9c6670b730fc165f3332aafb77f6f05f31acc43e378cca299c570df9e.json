            category: _this3.filters.category || undefined,\n                tag: _this3.filters.tag || undefined\n              };\n              _context3.n = 3;\n              return listPhotos(params);\n            case 3:\n              _yield$listPhotos = _context3.v;\n              data = _yield$listPhotos.data;\n              items = data.items || [];\n              _this3.total = data.total || 0;\n              _this3.totalPages = data.totalPages || 1;\n              _this3.photos = append ? _this3.photos.concat(items) : items;\n              _context3.n = 5;\n              break;\n            case 4:\n              _context3.p = 4;\n              _t = _context3.v;\n              _this3.error = ((_e$response = _t.response) === null || _e$response === void 0 || (_e$response = _e$response.data) === null || _e$response === void 0 ? void 0 : _e$response.message) || 'Failed to load photos';\n            case 5:\n              _context3.p = 5;\n              _this3.loading = false;\n              _this3.loadingMore = false;\n              return _context3.f(5);\n            case 6:\n              return _context3.a(2);\n          }\n        }, _callee3, null, [[2, 4, 5, 6]]);\n      }))();\n    },\n    openLightbox: function openLightbox(index) {\n      this.lightbox.index = index;\n      this.lightbox.open = true;\n      this.attachKeydown();\n    },\n    closeLightbox: function closeLightbox() {\n      this.lightbox.open = false;\n      this.detachKeydown();\n    },\n    prev: function prev() {\n      if (this.photos.length === 0) return;\n      this.lightbox.index = (this.lightbox.index - 1 + this.photos.length) % this.photos.length;\n    },\n    next: function next() {\n      if (this.photos.length === 0) return;\n      this.lightbox.index = (this.lightbox.index + 1) % this.photos.length;\n    },\n    attachKeydown: function attachKeydown() {\n      var _this4 = this;\n      if (this.onKeydown) return;\n      this.onKeydown = function (e) {\n        if (!_thi